# Copy to .env for local Docker development. Never commit the real file.
PROJECT_LEDGER_ENV=development
PROJECT_LEDGER_DEBUG=true
PROJECT_LEDGER_SECRET_KEY=replace-with-at-least-50-random-characters
PROJECT_LEDGER_JWT_SIGNING_KEY=replace-with-a-separate-random-signing-key
PROJECT_LEDGER_REFRESH_TOKEN_PEPPER=replace-with-a-separate-random-pepper
PROJECT_LEDGER_INVITE_TOKEN_PEPPER=replace-with-a-separate-random-pepper
PROJECT_LEDGER_SHORTCUT_TOKEN_PEPPER=replace-with-a-separate-random-pepper
PROJECT_LEDGER_ALLOWED_HOSTS=localhost,127.0.0.1
PROJECT_LEDGER_CORS_ALLOWED_ORIGINS=
PROJECT_LEDGER_PUBLIC_REGISTRATION=false
PROJECT_LEDGER_APP_NAME=Project Ledger
PROJECT_LEDGER_BUNDLE_ID=com.example.projectledger
PROJECT_LEDGER_PUBLIC_API_BASE_URL=https://replace-me.ts.net
PROJECT_LEDGER_DEFAULT_TIME_ZONE=Europe/Tirane
PROJECT_LEDGER_DEFAULT_CURRENCY=ALL
PROJECT_LEDGER_ACCESS_TOKEN_MINUTES=10
PROJECT_LEDGER_REFRESH_TOKEN_DAYS=30
PROJECT_LEDGER_SYNC_RETENTION_DAYS=90
PROJECT_LEDGER_SYNC_OPERATION_RECEIPT_DAYS=120
PROJECT_LEDGER_SYNC_MAX_PUSH_OPERATIONS=100
PROJECT_LEDGER_SYNC_DEFAULT_PULL_LIMIT=100
PROJECT_LEDGER_SYNC_MAX_PULL_LIMIT=500
PROJECT_LEDGER_SHORTCUT_TOKEN_DAYS=90
PROJECT_LEDGER_SHORTCUT_IDEMPOTENCY_DAYS=120
PROJECT_LEDGER_SHORTCUT_MAX_BATCH_SIZE=50
PROJECT_LEDGER_BUDGET_MAX_ROLLOVER_PERIODS=600
PROJECT_LEDGER_LOG_LEVEL=INFO
PROJECT_LEDGER_DATABASE_URL=postgresql://projectledger:change-me@postgres:5432/projectledger
PROJECT_LEDGER_REDIS_URL=redis://redis:6379/0
PROJECT_LEDGER_CELERY_BROKER_URL=redis://redis:6379/1
PROJECT_LEDGER_CELERY_RESULT_BACKEND=redis://redis:6379/2
PROJECT_LEDGER_MEDIA_ROOT=/var/lib/projectledger/media
PROJECT_LEDGER_EXPORT_ROOT=/var/lib/projectledger/exports

# One-time first-owner bootstrap. Remove immediately after use.
PROJECT_LEDGER_BOOTSTRAP_EMAIL=
PROJECT_LEDGER_BOOTSTRAP_PASSWORD=
PROJECT_LEDGER_BOOTSTRAP_DISPLAY_NAME=

# Compose-only defaults. Change all production values.
POSTGRES_DB=projectledger
POSTGRES_USER=projectledger
POSTGRES_PASSWORD=change-me
